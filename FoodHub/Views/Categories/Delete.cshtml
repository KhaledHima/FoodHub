@model FoodHub.Models.Category
@{
    ViewData["Title"] = "Delete category";
}

<h1>Delete category</h1>
<h3>Are you sure you want to delete @Model.Name?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Slug)</dt>
    <dd class="col-sm-10">@Model.Slug</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Icon)</dt>
    <dd class="col-sm-10">@Model.Icon</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
