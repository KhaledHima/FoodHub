@model FoodHub.Models.Category
@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index">← Back to categories</a>

<h1 class="mt-3">@Model.Icon @Model.Name</h1>
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Slug)</dt>
    <dd class="col-sm-10">@Model.Slug</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
