@model FoodHub.Models.Restaurant
@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index">← Back to restaurants</a>

<h1 class="mt-3">@Model.Name</h1>
<p class="lead">@Model.Category?.Icon @Model.Category?.Name · ⭐ @Model.AverageRating (@Model.Reviews.Count reviews)</p>
@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p>@Model.Description</p>
}

<ul>
    <li>@Html.DisplayNameFor(model => model.Address): @Model.Address</li>
    <li>@Html.DisplayNameFor(model => model.Phone): @Model.Phone</li>
    <li>@Html.DisplayNameFor(model => model.DeliveryFee): @Model.DeliveryFee.ToString("0.00") EGP</li>
    <li>@Html.DisplayNameFor(model => model.MinOrder): @Model.MinOrder.ToString("0.00") EGP</li>
    <li>@Html.DisplayNameFor(model => model.DeliveryMinutes): ~@Model.DeliveryMinutes min</li>
    <li>Status: @(Model.IsOpen ? "Open now" : "Closed")</li>
</ul>

<h3 class="mt-4">Menu</h3>
@if (Model.MenuItems.Count == 0)
{
    <p class="text-muted">No menu items yet.</p>
}
else
{
    <ul class="list-group col-md-6">
        @foreach (var item in Model.MenuItems)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@item.Name @(item.IsPopular ? "🔥" : "")</span>
                <span>@item.Price.ToString("0") EGP</span>
            </li>
        }
    </ul>
}
